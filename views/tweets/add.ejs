<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <h1>Welcome to Tweeter</h1>
  <h2>Add a Tweet</h2>

  <div class="box">
    <%- include('../partials/errors', { errors: errors }) %>

    <form action="/addTweet" method="post">
      <p>
        <label for="title">Title</label><br>
        <input id="title" type="text" name="title" value="<%= values.title || '' %>">
      </p>
      <p>
        <label for="tweet">Tweet</label><br>
        <textarea id="tweet" name="tweet" rows="4" cols="40"><%= values.tweet || '' %></textarea>
      </p>
      <p>
        <button class="btn" type="submit">Submit</button>
      </p>
    </form>
  </div>

  <p><a href="/tweet">Back</a></p>

  <%- include('../partials/footer') %>
