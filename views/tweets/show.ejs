<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <h1>Welcome to Tweeter</h1>

  <h2><%= tweet.title %></h2>
  <p><%= tweet.tweet %></p>

  <form action="/tweet/<%= tweet._id %>/delete" method="post">
    <button class="btn delete" type="submit">Delete</button>
  </form>

  <p><a class="btn" href="/tweet/edit/<%= tweet._id %>">Edit Post</a></p>

  <p><a href="/tweet">Back</a></p>

  <%- include('../partials/footer') %>
