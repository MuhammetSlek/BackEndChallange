<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <h1>Welcome to Tweeter</h1>

  <p>
    There <%= tweets.length === 1 ? 'is' : 'are' %> <%= tweets.length %>
    tweet<%= tweets.length === 1 ? '' : 's' %>
  </p>

  <p><a class="btn" href="/addTweet">Add Tweet</a></p>

  <% if (flash) { %>
    <p><%= flash.message %></p>
  <% } %>

  <% if (!tweets.length) { %>
    <p>No tweets yet.</p>
  <% } %>

  <% tweets.forEach(function (tweet) { %>
    <h2><%= tweet.title %></h2>
    <p><%= tweet.tweet %></p>
    <p><a href="/tweet/<%= tweet._id %>">See More</a></p>
    <hr>
  <% }); %>

  <%- include('../partials/footer') %>
