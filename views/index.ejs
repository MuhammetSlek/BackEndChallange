<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <h1>Login and Registration</h1>

  <% if (loginRequired) { %>
    <p>You must be logged in to view the tweets.</p>
  <% } %>

  <% if (registered) { %>
    <p>Your account was created. You can log in now.</p>
  <% } %>

  <h2>Login</h2>
  <div class="box">
    <% if (form === 'login') { %>
      <%- include('partials/errors', { errors: errors }) %>
    <% } %>

    <form action="/login" method="post">
      <p>
        <label for="login-email">Email:</label><br>
        <input id="login-email" type="email" name="email" value="<%= form === 'login' ? values.email : '' %>">
      </p>
      <p>
        <label for="login-password">Password:</label><br>
        <input id="login-password" type="password" name="password">
      </p>
      <p>
        <button class="btn" type="submit">Login</button>
      </p>
    </form>
  </div>

  <h2>Register</h2>
  <div class="box">
    <% if (form === 'register') { %>
      <%- include('partials/errors', { errors: errors }) %>
    <% } %>

    <form action="/register" method="post">
      <p>
        <label for="firstName">First Name:</label><br>
        <input id="firstName" type="text" name="firstName" value="<%= form === 'register' ? values.firstName : '' %>">
      </p>
      <p>
        <label for="lastName">Last Name:</label><br>
        <input id="lastName" type="text" name="lastName" value="<%= form === 'register' ? values.lastName : '' %>">
      </p>
      <p>
        <label for="register-email">Email Address:</label><br>
        <input id="register-email" type="email" name="email" value="<%= form === 'register' ? values.email : '' %>">
      </p>
      <p>
        <label for="register-password">Password:</label><br>
        <input id="register-password" type="password" name="password">
      </p>
      <p>
        <label for="confirmPassword">Confirm Password:</label><br>
        <input id="confirmPassword" type="password" name="confirmPassword">
      </p>
      <p>
        <button class="btn" type="submit">Register</button>
      </p>
    </form>
  </div>

  <%- include('partials/footer') %>
