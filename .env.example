# .env.example -- the template that IS committed.
# Copy it to .env and fill in your real values:  copy .env.example .env
# .env is ignored by git, so the password never reaches GitHub.

PORT=3000

# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/backend_challenge

# MongoDB Atlas (this project uses Atlas):
# replace USER, PASSWORD and CLUSTER, keep the database name in the path.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/backend_challenge?retryWrites=true&w=majority

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
